# Robot Sensors and Devices udev rules

# 1. IMU (CH341, Serial: 0003, 任意USB口)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", ATTRS{serial}=="0003", SYMLINK+="my_imu", MODE="0666", GROUP="dialout"

# 2. Lidar (CH341, Serial: 0002, 任意USB口)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", ATTRS{serial}=="0002", SYMLINK+="my_lidar", MODE="0666", GROUP="dialout"

# 3. TC264下位机 (物理端口绑定, 7-1端口位置)
SUBSYSTEM=="tty", KERNELS=="7-1", SYMLINK+="my_tc264", MODE="0666", GROUP="dialout"

